! ====== Part 3-10: Default Gateway & IP addressSRV1  =====
! GUI에서 설정 (Desktop > IP Configuration)
!   IP: 10.5.0.4 / 255.255.255.0 / GW: 10.5.0.1
!
!
! ===== Part 3-11: Management IP addresses (int vlan 99) On Access switches 
! & default gateway - first usable address =====

! ASW-A1
int vlan 99
  ip add 10.0.0.4 255.255.255.240
  no shut
  exit
ip default-gateway 10.0.0.1

! ASW-A2
int vlan 99
  ip add 10.0.0.5 255.255.255.240
  no shut
  exit
ip default-gateway 10.0.0.1

! ASW-A3
int vlan 99
  ip add 10.0.0.6 255.255.255.240
  no shut
  exit
ip default-gateway 10.0.0.1

! ASW-B1
int vlan 99
  ip add 10.0.0.20 255.255.255.240
  no shut
  exit
ip default-gateway 10.0.0.17

! ASW-B2
int vlan 99
  ip add 10.0.0.21 255.255.255.240
  no shut
  exit
ip default-gateway 10.0.0.17

! ASW-B3
int vlan 99
  ip add 10.0.0.22 255.255.255.240
  no shut
  exit
ip default-gateway 10.0.0.17


! ===== part 3-12: HSRPv2 for Office A's Management subnet (vlan 99) =====

! DSW-A1 : ip add & HSRPv2 group 1 & Active & preempt on 
int vlan 99
  ip add 10.0.0.2 255.255.255.240
  standby version 2
  standby 1 ip 10.0.0.1
  standby 1 priority 105
  standby 1 preempt

! DSW-A2 : ip add & HSRPv2 group 1
int vlan 99
  ip add 10.0.0.3 255.255.255.240
  standby version 2
  standby 1 ip 10.0.0.1


! ===== part 3-13: HSRPv2 for Office A's PCs subnet (vlan 10) =====

! DSW-A1 : vlan 10 ip add & HSRPv2 group 2 & Active & preempt on
int vlan 10
  ip add 10.1.0.2 255.255.255.0
  standby version 2
  standby 2 ip 10.1.0.1
  standby 2 priority 105
  standby 2 preempt

! DSW-A2 : vlan 10 ip add & HSRPv2 group 2
int vlan 10
  ip add 10.1.0.3 255.255.255.0
  standby version 2
  standby 2 ip 10.1.0.1


! ===== part 3-14: HSRPv2 for Office A's Phones subnet (vlan 20) =====

! DSW-A1 : vlan 20 ip add & HSRPv2 group 3 
int vlan 20
  ip add 10.2.0.2 255.255.255.0
  standby version 2
  standby 3 ip 10.2.0.1

! DSW-A2 : vlan 20 ip add & HSRPv2 group 3 & Active & preempt on
int vlan 20
  ip add 10.2.0.3 255.255.255.0
  standby version 2
  standby 3 ip 10.2.0.1
  standby 3 priority 105
  standby 3 preempt


! ===== part 3-15: HSRPv2 for Office A's Wi-Fi subnet (vlan 40) =====

! DSW-A1 : vlan 40 ip add & HSRPv2 group 4
int vlan 40
  ip add 10.6.0.2 255.255.255.0
  standby version 2
  standby 4 ip 10.6.0.1

! DSW-A2 : vlan 40 ip add & HSRPv2 group 4 & Active & preempt on
int vlan 40
  ip add 10.6.0.3 255.255.255.0
  standby version 2
  standby 4 ip 10.6.0.1
  standby 4 priority 105
  standby 4 preempt


! ===== part 3-16: HSRPv2 for Office B's Management subnet (vlan 99) =====

! DSW-B1 : ip add & HSRPv2 group 1 & Active & preempt on
int vlan 99
  ip add 10.0.0.18 255.255.255.240
  standby version 2
  standby 1 ip 10.0.0.17
  standby 1 priority 105
  standby 1 preempt

! DSW-B2 : ip add & HSRPv2 group 1
int vlan 99
  ip add 10.0.0.19 255.255.255.240
  standby version 2
  standby 1 ip 10.0.0.17


! ===== part 3-17: HSRPv2 for Office B's PCs subnet (vlan 10) =====

! DSW-B1 : vlan 10 ip add & HSRPv2 group 2 & Active & preempt on
int vlan 10
  ip add 10.3.0.2 255.255.255.0
  standby version 2
  standby 2 ip 10.3.0.1
  standby 2 priority 105
  standby 2 preempt

! DSW-B2 : vlan 10 ip add & HSRPv2 group 2
int vlan 10
  ip add 10.3.0.3 255.255.255.0
  standby version 2
  standby 2 ip 10.3.0.1


! ===== part 3-18: HSRPv2 for Office B's Phones subnet (vlan 20) =====  

! DSW-B1 : vlan 20 ip add & HSRPv2 group 3
int vlan 20
  ip add 10.4.0.2 255.255.255.0
  standby version 2
  standby 3 ip 10.4.0.1

! DSW-B2 : vlan 20 ip add & HSRPv2 group 3 & Active & preempt on
int vlan 20
  ip add 10.4.0.3 255.255.255.0
  standby version 2
  standby 3 ip 10.4.0.1
  standby 3 priority 105
  standby 3 preempt


! ===== part 3-19: HSRPv2 for Office B's Servers subnet (vlan 30) =====

! DSW-B1 : vlan 30 ip add & HSRPv2 group 4
int vlan 30
  ip add 10.5.0.2 255.255.255.0
  standby version 2
  standby 4 ip 10.5.0.1

! DSW-B2 : vlan 30 ip add & HSRPv2 group 4 & Active & preempt on
int vlan 30
  ip add 10.5.0.3 255.255.255.0