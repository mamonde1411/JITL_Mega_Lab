! ===== Part 3-1: ip address on R1 =====
int g0/0/0
  description ### to ISP A ###
  ip add dhcp
  no shutdown
!
int g0/1/0
  description ### to ISP B ###
  ip add dhcp
  no shutdown
!
int g0/0
  description ### to CSW1 G1/0/1 ###
  ip add 10.0.0.33 255.255.255.252
  no shutdown
!
int g0/1
  description ### to CSW2 G1/0/1 ###
  ip add 10.0.0.37 255.255.255.252
  no shutdown
!
int l0
  description ### loopback0 ###
  ip add 10.0.0.76 255.255.255.255
!
!
! ===== Part 3-2: IPv4 routing on all Core & Distribution Switches =====
! On all Core & Distribution Switches
ip routing
!
!
! ===== Part 3-3: Pagp between CSW1 and CSW2 =====
! On CSW1
int range G1/0/2 - 3
  description ### pagp to CSW2 G1/0/2 - 3 ###
  no switchport
  channel-group 1 mode desirable
int po1
  description ### pagp to CSW2 G1/0/2 - 3 ###
  ip add 10.0.0.41 255.255.255.252
  no shutdown
!
! On CSW2
int range G1/0/2 - 3
  description ### pagp to CSW1 G1/0/2 - 3 ###
  no switchport
  channel-group 1 mode desirable
int po1
  description ### pagp to CSW1 G1/0/2 - 3 ###
  ip add 10.0.0.42 255.255.255.252
  no shutdown
!
!
! ===== Part 3-4: IP addresses on CSW1 =====
!
int g1/0/1
  description ### to R1 G0/0 ###
  no switchport
  ip add 10.0.0.34 255.255.255.252
  no shutdown
!
int g1/1/1
 description ### to DSW-A1 G1/1/1 ###
  no switchport
  ip add 10.0.0.45 255.255.255.252
  no shutdown
!
int g1/1/2
  description ### to DSW-A2 G1/1/1 ###
  no switchport
  ip add 10.0.0.49 255.255.255.252
  no shutdown
!
int g1/1/3
  description ### to DSW-B1 G1/1/1 ###
  no switchport
  ip add 10.0.0.53 255.255.255.252
  no shutdown
!
int g1/1/4
  description ### to DSW-B2 G1/1/1 ###
  no switchport
  ip add 10.0.0.57 255.255.255.252
  no shutdown
!
int l0
  description ### loopback0 ###
  ip add 10.0.0.77 255.255.255.255
!
! Shutdown all unused ports on CSW1
int range g1/0/4 - 24
  shutdown
!
!
! ===== Part 3-5: IP addresses on CSW2 =====
!
