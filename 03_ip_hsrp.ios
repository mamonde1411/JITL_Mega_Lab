! ======= DSW-A1 =======

! vlan 99 ip add & HSRPv2 group 1
int vlan 99
  ip add 10.0.0.2 255.255.255.240
  standby version 2
  standby 1 ip 10.0.0.1
  standby 1 priority 105
  standby 1 preempt
!
!
! vlan 10 ip add & HSRPv2 group 2
int vlan 10
  ip add 10.1.0.2 255.255.255.0
  standby version 2
  standby 2 ip 10.1.0.1
  standby 2 priority 105
  standby 2 preempt 
!
!
! vlan 20 ip add & HSRPv2 group 3
int vlan 20
  ip add 10.2.0.3 255.255.255.0
  standby version 2
  standby 3 ip 10.2.0.1
  no shut
!
!
! vlan 40 ip add & HSRPv2 group 4
int vlan 40
  ip add 10.6.0.3 255.255.255.0
  standby version 2
  standby 4 ip 10.6.0.1
  no shut
!
!
